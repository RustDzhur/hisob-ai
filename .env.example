# Скопируйте в .env и замените значения. Файл .env в git не попадает.
# Пароли генерируйте случайно, например: openssl rand -hex 24
# (hex безопасен для подстановки в URL подключения к БД).

# Суперпользователь PostgreSQL: нужен только для инициализации и тестов.
POSTGRES_ADMIN_PASSWORD=change-me
# Владелец схемы, выполняет миграции Alembic.
MIGRATOR_DB_PASSWORD=change-me
# Роль приложения: не владелец таблиц, без BYPASSRLS. Через неё работает API.
APP_DB_PASSWORD=change-me

# Ключи S3-хранилища файлов (SeaweedFS). Тоже случайные: openssl rand -hex 16 / 24
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Порты на хосте (только 127.0.0.1).
BACKEND_HOST_PORT=8300
FRONTEND_HOST_PORT=3300

# dev: cookie без Secure, чтобы работало по http через SSH-туннель.
# Для любого окружения с TLS: COOKIE_SECURE=true
COOKIE_SECURE=false

# --- Распознавание документов (срез 3.2). Значения вносит владелец в .env на сервере. ---
# Провайдер по умолчанию: openai или deepseek
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
